{
  "name": "tempalte-svelte-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "ldenv": "^0.6.0",
    "set-defaults": "^0.0.5",
    "syncpack": "^15.3.3",
    "zellij-launcher": "^0.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "prepare": "set-defaults .vscode",
    "preinstall": "npx only-allow pnpm",
    "---------------------- INSTALL ----------------------": "",
    "sync-deps": "syncpack fix-mismatches",
    "---------------------- DEV ----------------------": "",
    "web:dev": "ldenv pnpm --filter ./web dev",
    "web:build": "ldenv pnpm --filter ./web build",
    "---------------------- TEST ----------------------": "",
    "web:check": "pnpm --filter ./web check",
    "web:test": "pnpm --filter ./web test",
    "test": "pnpm web:test",
    "verify": "pnpm web:check && pnpm web:test && pnpm web:build",
    "-- 'verify' is what a green tree means. No CI config ships with this --": "",
    "-- template on purpose: wire 'pnpm verify' into whatever CI you use ----": "",
    "---------------------- DEPLOY ----------------------": "",
    "build": "pnpm web:build",
    "serve": "pnpm run --filter ./web serve",
    "---------------------- RUN FULL LOCAL SETUP ----------------------": "",
    "stop": "zellij kill-session $npm_package_name",
    "start:pnpm": "pnpm -r dev",
    "start": "zellij-launcher a $npm_package_name || zellij -n zellij.kdl -s $npm_package_name"
  }
}
