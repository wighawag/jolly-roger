# A LAN box (github:wighawag/ethereum-lan-node), built by nix/lan.nix.
#
# Every url is SAME-HOST (`//:<port>`: the host this page came from), because
# the box answers on its hotspot address, on whatever the venue's network gave
# it and by name, and one build has to work on all of them. Nothing here may
# need the internet: there may be none.
PUBLIC_NODE_URL="//:8545"
PUBLIC_CHAIN_INFO_NODE_URL="//:8545"
# Every player gets a wallet in the browser, so nobody needs an extension.
PUBLIC_USE_BURNER_WALLET="//:8545"
PUBLIC_IMPERSONATE_ADDRESSES=
# The box's faucet: its page, and its API (POST /api/claim; it allows any
# origin, since each game is served on a port of its own).
PUBLIC_FAUCET_LINK="//:34010"
PUBLIC_FAUCET_API="//:34010"
# No ENS: it would need mainnet.
PUBLIC_ENS_NODE_URL=
PUBLIC_EXPLORER_BLOCK_INDEX_ENABLED="true"
PUBLIC_USE_INTERNAL_EXPLORER=true
