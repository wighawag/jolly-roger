# `//:8545` means "the host this page came from, port 8545", resolved in the
# browser. Written this way so the dev stack works from a phone on the LAN:
# `localhost` in a page opened at 192.168.x.y is the PHONE. An ordinary url
# still works exactly as before; see web/src/lib/core/env/same-host.ts.
PUBLIC_NODE_URL="//:8545"
PUBLIC_EXPLORER_BLOCK_INDEX_ENABLED="true"
PUBLIC_USE_BURNER_WALLET=$PUBLIC_NODE_URL
# Who the burner wallet can be, locally. Two well-known addresses, so there is
# someone to switch between; add more here (comma-separated) if you need them.
PUBLIC_IMPERSONATE_ADDRESSES="0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045,0xF78cD306b23031dE9E739A5BcDE61764e82AD5eF"
PUBLIC_FAUCET_LINK="//:34010"
# The local chain is unknown to every wallet, so it has to be addable. 127.0.0.1
# rather than localhost: wallets are stricter about the loopback literal.
PUBLIC_CHAIN_INFO_NODE_URL="//:8545"
