{
	"name": "template-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.1.2",
		"ipfs-gateway-emulator": "4.2.1-ipfs.2",
		"named-logs": "^0.4.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"pwag": "^0.4.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"typescript": "~6.0.3",
		"vite": "^8.2.0",
		"vite-plugin-devtools-json": "^1.1.0"
	},
	"scripts": {
		"prepare": "pnpm generate-pwa-icons-and-tags && svelte-kit sync || echo ''",
		"generate-pwa-icons-and-tags": "pwag static/icon.png src/web-config.json",
		"dev": "vite dev",
		"build": "vite build && node scripts/enable-eruda-plugins.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"serve": "ipfs-emulator --only -d build -p 8080"
	}
}
