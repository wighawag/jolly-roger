{
	"name": "template-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"devDependencies": {
		"@lucide/svelte": "^1.7.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"bits-ui": "^2.16.4",
		"clsx": "^2.1.1",
		"ipfs-gateway-emulator": "^5.0.0",
		"mode-watcher": "^1.1.0",
		"named-logs": "^0.4.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"pwag": "^0.8.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.2.1",
		"vite-plugin-devtools-json": "^1.1.0"
	},
	"scripts": {
		"prepare": "pnpm generate-pwa-icons-and-tags && svelte-kit sync || echo ''",
		"generate-pwa-icons-and-tags": "pwag static/icon.png src/web-config.json",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"serve": "ipfs-emulator --only -d build -p 8080"
	}
}
