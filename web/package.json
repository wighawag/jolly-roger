{
	"name": "jolly-roger-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"devDependencies": {
		"@etherkit/burner-wallet": "^0.0.8",
		"@etherkit/tx-observer": "0.1.0",
		"@etherkit/viem-tx-tracker": "^0.0.9",
		"@etherplay/connect": "^0.1.4",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.7.0",
		"@observator/svelte": "^0.3.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.2",
		"@vitest/browser-playwright": "^4.1.2",
		"bits-ui": "^2.16.4",
		"clsx": "^2.1.1",
		"eip-1193": "^0.6.5",
		"faucet-client": "^0.0.2",
		"ipfs-gateway-emulator": "^5.0.0",
		"json-stable-stringify": "^1.3.0",
		"ldenv": "^0.6.0",
		"mode-watcher": "^1.1.0",
		"named-logs": "^0.4.1",
		"observator": "^0.3.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"pwag": "^0.8.0",
		"radiate": "^0.3.2",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-sonner": "^1.1.0",
		"synqable": "^0.0.13",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"viem": "^2.55.11",
		"vite": "^8.2.0",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^4.1.2",
		"vitest-browser-svelte": "^3.0.0"
	},
	"scripts": {
		"prepare": "pnpm generate-pwa-icons && svelte-kit sync",
		"generate-pwa-icons": "pwag static/icon.svg src/web-config.json",
		"dev": "ldenv -d localhost -w vite dev --host @@",
		"build": "ldenv vite build @@",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"serve": "ipfs-emulator --only -d build -p 8080",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "bash ../scripts/run-e2e-tests.sh",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:headed": "playwright test --headed"
	}
}
