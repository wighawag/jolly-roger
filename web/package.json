{
	"name": "jolly-roger-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"devDependencies": {
		"@etherkit/burner-wallet": "^0.0.9",
		"@etherkit/tx-observer": "0.1.0",
		"@etherkit/viem-tx-tracker": "^0.1.0",
		"@etherplay/connect": "^0.13.0",
		"@etherplay/dev-wallet-host": "^0.1.1",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.33.0",
		"@observator/svelte": "^0.3.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"@vitest/browser-playwright": "^4.1.11",
		"bits-ui": "^2.18.2",
		"clsx": "^2.1.1",
		"eip-1193": "^0.6.5",
		"faucet-client": "^0.1.0",
		"ipfs-gateway-emulator": "^5.1.0",
		"json-stable-stringify": "^1.3.0",
		"ldenv": "^0.6.0",
		"mode-watcher": "^1.1.0",
		"named-logs": "^0.4.1",
		"observator": "^0.3.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"pwag": "^0.8.0",
		"radiate": "^0.3.2",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"synqable": "^0.0.13",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vaul-svelte": "1.0.0-next.7",
		"viem": "^2.55.19",
		"vite": "^8.2.1",
		"vite-plugin-devtools-json": "^1.1.0",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^3.0.0"
	},
	"scripts": {
		"prepare": "pnpm generate-pwa-icons && svelte-kit sync",
		"generate-pwa-icons-and-tags": "pwag static/icon.png src/web-config.json",
		"dev": "ldenv -d localhost -w vite dev --host @@",
		"wallet-host": "dev-wallet-host --port ${PUBLIC_WALLET_HOST_PORT:-50000}",
		"build": "ldenv vite build @@",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "npm run test:unit && npm run test:e2e",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"serve": "ipfs-emulator --only -d build -p 8080",
		"test:e2e": "bash ../scripts/run-e2e-tests.sh",
		"test:e2e:headed": "playwright test --headed",
		"generate-pwa-icons": "pwag static/icon.svg src/web-config.json",
		"test:unit": "vitest run --project server && vitest run --project client",
		"test:unit:watch": "vitest",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug"
	}
}
