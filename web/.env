# Public environment variables, embedded in the client bundle at build time.
# Never put a secret here: everything in this file ships to the browser.
#
# This file holds the DEFAULTS and is committed. Override locally in
# `.env.local`, which is gitignored.

# Set to true to register the service worker in dev mode (default: off, so HMR
# is not intercepted by the SW cache). Useful for developing the SW itself.
PUBLIC_ENABLE_SW_IN_DEV=
