{
	"name": "jolly-roger-contracts",
	"version": "0.0.0",
	"type": "module",
	"exports": {
		"./deploy/*": "./dist/deploy/*",
		"./rocketh/*": "./dist/rocketh/*",
		"./artifacts/*": "./dist/generated/artifacts/*",
		"./abis/*": "./dist/generated/abis/*",
		"./deployments/*": "./deployments/*",
		"./src/*": "./src/*"
	},
	"files": [
		"dist",
		"src",
		"deployments"
	],
	"devDependencies": {
		"@nomicfoundation/hardhat-keystore": "^3.0.8",
		"@nomicfoundation/hardhat-network-helpers": "^3.0.7",
		"@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
		"@nomicfoundation/hardhat-viem": "^3.0.6",
		"@rocketh/deploy": "^0.19.9",
		"@rocketh/doc": "^0.19.8",
		"@rocketh/export": "^0.19.9",
		"@rocketh/node": "^0.19.8",
		"@rocketh/proxy": "^0.19.15",
		"@rocketh/read-execute": "^0.19.4",
		"@rocketh/router": "^0.19.11",
		"@rocketh/signer": "^0.19.4",
		"@rocketh/verifier": "^0.19.8",
		"@rocketh/viem": "^0.19.4",
		"@types/node": "^26.1.2",
		"as-soon": "^0.1.6",
		"earl": "^2.0.0",
		"expand-vars": "^0.1.0",
		"faucet-server": "^0.1.0",
		"forge-std": "github:foundry-rs/forge-std#v1.9.4",
		"hardhat": "^3.12.0",
		"hardhat-deploy": "^2.0.11",
		"hardhat-external-artifacts": "^0.0.6",
		"ldenv": "^0.6.0",
		"prettier": "^3.8.0",
		"prettier-plugin-solidity": "^2.3.1",
		"purgatory": "^0.0.8",
		"rocketh": "^0.19.8",
		"set-defaults": "^0.0.5",
		"slippy": "^0.3.1",
		"tsx": "^4.21.0",
		"typescript": "~6.0.3",
		"viem": "^2.47.6",
		"wait-on": "^9.0.4",
		"zellij-launcher": "^0.0.1"
	},
	"scripts": {
		"prepare": "set-defaults .vscode && pnpm compile",
		"---------------------- INTERNAL ----------------------": "",
		":deploy:dev+export": "expand-vars pnpm hardhat --network $MODE deploy --no-compile --skip-prompts && expand-vars rocketh-export -e $MODE",
		"---------------------- DEV ---------------------- ": "",
		"node:local": "ldenv -d localhost hardhat --network local node",
		"node:purgatory": "purgatory --port 8545 --reset-db --db purgatory.db",
		"faucet": "ldenv -w faucet --no-captcha --port 34010",
		"compile": "hardhat compile",
		"compile:watch": "as-soon -w src pnpm compile",
		"fork:execute": "ldenv tsx @=HARDHAT_FORK=@@MODE @@",
		"fork:deploy": "ldenv pnpm @=HARDHAT_FORK=@@MODE hardhat --network fork deploy --report-gas-used @@",
		"deploy:dev": "ldenv -d localhost pnpm :deploy:dev+export @@",
		"deploy:watch": "wait-on ./generated && ldenv -m localhost pnpm as-soon -w generated -w deploy pnpm run deploy:dev @@MODE @@",
		"test": "hardhat test",
		"test:watch": "wait-on ./generated && as-soon -w generated -w test hardhat test --no-compile",
		"typescript:watch": "as-soon -w js pnpm typescript",
		"format:check": "prettier --check .",
		"format": "prettier --write .",
		"lint": "slippy src/**/*.sol",
		"---------------------- PRODUCTION ---------------------- ": "",
		"docgen": "ldenv -m default pnpm run deploy @@MODE --save-deployments true --skip-prompts ~~ pnpm rocketh-doc -e @@MODE --except-suffix _Implementation,_Proxy,_Router,_Route ~~ @@",
		"execute": "ldenv -n HARDHAT_NETWORK tsx @@",
		"deploy": "ldenv hardhat --network @@MODE deploy @@",
		"verify": "ldenv rocketh-verify -e @@MODE @@",
		"export": "ldenv rocketh-export -e @@MODE @@",
		"typescript": "tsc",
		"---------------------- START ---------------------- ": "",
		"stop": "zellij kill-session $npm_package_name",
		"start": "zellij-launcher a $npm_package_name || zellij -n zellij.kdl -s $npm_package_name"
	}
}
